generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Log {
  id        String   @id @default(uuid())
  detail    String   @db.Text
  type      LogType
  kioskId   String
  kiosk     Kiosk    @relation(fields: [kioskId], references: [macId])
  createdAt DateTime
}

model Transaction {
  id             String     @id @default(uuid())
  quantity       Int
  tissueType     TissueType
  status         Status
  selectedAnswer String?    @db.Text
  error          String?    @db.Text
  questionId     String?
  quoteId        String?
  time           DateTime   @default(now())
  kioskId        String
  kiosk          Kiosk      @relation(fields: [kioskId], references: [macId])
  question       Question?  @relation(fields: [questionId], references: [id])
  quote          Quote?     @relation(fields: [quoteId], references: [id])
}

model Quote {
  id         String        @id @default(uuid())
  quote      String
  isActive   Boolean       @default(true)
  kioskId    String
  kiosk      Kiosk         @relation(fields: [kioskId], references: [macId])
  appearance Transaction[]
}

model Kiosk {
  macId                  String         @id @unique
  type                   KioskType      @default(OPEN)
  errors                 Json           @default("[]")
  name                   String
  sheets_per_transaction Int            @default(5)
  answer_required        Boolean        @default(false)
  screen_sequence        Json           @default("[\"WelcomeScreen\", \"LoginScreen\", \"SelectScreen\", \"SurveyScreen\", \"QuotesScreen\"]")
  machineInfo            Json           @default("{}")
  location               Json           @default("{}")
  scented                Int            @default(0)
  unscented              Int            @default(0)
  temperature            Int            @default(0)
  customerId             String?
  isActive               Boolean        @default(true)
  lastSeen               DateTime       @default(now())
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  isDeleted              Boolean        @default(false)
  customer               Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  onSiteContact          OnSiteContact? @relation("Contact")
  Quotes                 Quote[]
  Questions              Question[]
  logs                   Log[]
  transactions           Transaction[]

  @@index([customerId])
}

model OnSiteContact {
  id        String @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String
  kioskId   String @unique
  kiosk     Kiosk  @relation(fields: [kioskId], references: [macId], onDelete: Cascade, name: "Contact")
}

model Customer {
  id         String   @id @default(uuid())
  schoolName String
  firstName  String
  lastName   String
  city       String
  address    String
  state      String
  zip        String
  email      String   @unique
  country    String
  phone      String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  kiosks     Kiosk[]
  users      Users[]
}

model Users {
  id              String             @id @default(uuid())
  email           String             @unique
  firstName       String
  lastName        String
  password        String             @db.Text
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  studentId       String?            @unique
  accountDate     String?
  accountStatus   accountStatus?    @default(Active)
  DOB             String?
  phone           String?
  accountType     SubscriptionTypes? @default(Free)
  scented         Int?               @default(0)
  unscented       Int?               @default(0)
  personalEmail   String?
  gender          Gender?            @default(Other)
  sheetPreference TissueType?        @default(unscented)
  uniquePin       Int?
  classYear       classYearType?     @default(Freshman)
}

model Question {
  id            String        @id @default(uuid())
  question      String
  options       Json
  isActive      Boolean       @default(true)
  kioskId       String
  kiosk         Kiosk         @relation(fields: [kioskId], references: [macId])
  questionAsked Transaction[]
}

enum TissueType {
  scented
  unscented
}

enum Gender {
  Male
  Female
  Other
}

enum classYearType {
  Freshman
  Sophomore
  Junior
  Senior
  Graduate
}

enum accountStatus {
  Active
  Inactive
}

enum SubscriptionTypes {
  Paid
  Free
}

enum KioskType {
  AUTH
  OPEN
}

enum LogType {
  ERROR
  WARNING
  INFO
}

enum Status {
  SUCCESS
  FAILED
}
