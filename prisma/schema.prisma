generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Log {
  id        String   @id @default(uuid())
  detail    String   @db.Text
  type      LogType
  kioskId   String
  kiosk     Kiosk    @relation(fields: [kioskId], references: [macId])
  createdAt DateTime
}

model Transaction {
  id             String     @id @default(uuid())
  quantity       Int
  tissueType     TissueType
  status         Status
  selectedAnswer String?    @db.Text
  error          String?    @db.Text
  questionId     String?
  quoteId        String?
  time           DateTime   @default(now())
  kioskId        String
  kiosk          Kiosk      @relation(fields: [kioskId], references: [macId])
  question       Question?  @relation(fields: [questionId], references: [id])
  quote          Quote?     @relation(fields: [quoteId], references: [id])
  questions      TransactionQuestion[]
}

model Kiosk {
  macId                  String         @id @unique
  type                   KioskType      @default(OPEN)
  errors                 Json           @default("[]")
  name                   String
  sheets_per_transaction Int            @default(5)
  answer_required        Boolean        @default(false)
  screen_sequence        Json           @default("[\"WelcomeScreen\", \"LoginScreen\", \"SelectScreen\", \"SQfollowedbyEM\"]")
  machineInfo            Json           @default("{}")
  location               Json           @default("{}")
  scented                Int            @default(0)
  unscented              Int            @default(0)
  temperature            Int            @default(0)
  customerId             String?
  isActive               Boolean        @default(true)
  lastSeen               DateTime       @default(now())
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  isDeleted              Boolean        @default(false)
  customer               Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  onSiteContact          OnSiteContact? @relation("Contact")
  // Quotes                 Quote[]
  // Questions              Question[]
  logs                   Log[]
  transactions           Transaction[]

  relations KioskRelation[]
  Question  Question[]
  Quote     Quote[]

  @@index([customerId])
}

model Question {
  id            String        @id @default(uuid())
  question      String
  options       Json
  isActive      Boolean       @default(true)
  kioskId       String?
  kiosk         Kiosk?         @relation(fields: [kioskId], references: [macId])
  questionAsked Transaction[]
  questionAskedTransaction TransactionQuestion[]
  relations KioskRelation[]
}

model TransactionQuestion {
  id             String       @id @default(uuid())
  transactionId  String
  questionId     String
  answer         String?      @db.Text
  transaction    Transaction  @relation(fields: [transactionId], references: [id])
  question       Question     @relation(fields: [questionId], references: [id])

  @@unique([transactionId, questionId])
}

model Quote {
  id         String        @id @default(uuid())
  quote      String
  isActive   Boolean       @default(true)
  kioskId    String?
  kiosk      Kiosk?        @relation(fields: [kioskId], references: [macId])
  appearance Transaction[]

  relations KioskRelation[]
}

model KioskRelation {
  id         String       @id @default(uuid())
  kioskId    String
  kiosk      Kiosk        @relation(fields: [kioskId], references: [macId])
  questionId String?
  question   Question?    @relation(fields: [questionId], references: [id])
  quoteId    String?
  quote      Quote?       @relation(fields: [quoteId], references: [id])
  type       RelationType
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([kioskId, questionId, quoteId])
}

model OnSiteContact {
  id        String @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String
  kioskId   String @unique
  kiosk     Kiosk  @relation(fields: [kioskId], references: [macId], onDelete: Cascade, name: "Contact")
}

model Customer {
  id         String   @id @default(uuid())
  schoolName String
  firstName  String
  lastName   String
  city       String
  address    String
  state      String
  zip        String
  email      String   @unique
  country    String
  phone      String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  kiosks     Kiosk[]
  users      Users[]
}

model Users {
  id         String   @id @default(uuid())
  email      String   @unique
  firstName  String
  lastName   String
  password   String   @db.Text
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum RelationType {
  QUESTION
  QUOTE
}

enum TissueType {
  scented
  unscented
}

enum Gender {
  M
  F
  Other
}

enum SubscriptionTypes {
  PAID
  FREE
}

enum KioskType {
  AUTH
  OPEN
}

enum LogType {
  ERROR
  WARNING
  INFO
}

enum Status {
  SUCCESS
  FAILED
}
